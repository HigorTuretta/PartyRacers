/* Toast.uss — HTML linhas 831-836 */
.toast {
    padding: 11px 14px;
    border-width: 3px; border-color: var(--ink); border-radius: 11px;
    background-color: var(--glass-90);
}
.toast__swatch { width: 26px; height: 26px; flex-shrink: 0; border-radius: 7px; background-color: var(--amber); }
.toast__text {
    -unity-font-definition: url("project://database/Assets/_Projeto/UI/Core/Fonts/Archivo-Bold SDF.asset");
    font-size: 14px; color: var(--cream); white-space: normal;
}
