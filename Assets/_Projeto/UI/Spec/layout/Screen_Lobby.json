{
  "screen": "Screen_Lobby",
  "scene": "Frontend",
  "canvas": {
    "referenceResolution": [
      1920,
      1080
    ],
    "screenMatchMode": "MatchWidthOrHeight",
    "match": 0.5,
    "note": "Telas de celular usam o MESMO canvas em 2340x1080 paisagem + Safe Area."
  },
  "intent": "Cena 3D da garagem no centro. Os painéis são colunas laterais e a barra de ação é rodapé; nada opaco entra na zona franca. O grupo fica à esquerda, os amigos à direita, a ação embaixo.\nA fileira de karts em SQUAD ocupa 930px (1 kart do jogador 360 + 3 acompanhantes 170 + 3 gaps de 20), centralizada em x=960 → [495,1425]. Cabe na zona franca com 25px de folga de cada lado.",
  "camera3D": {
    "rig": "LobbyCameraRig",
    "pose": "orbit_3q",
    "fov": 34,
    "target": "PlayerKartRoot",
    "idle": "orbita lenta 6 graus/s + bob senoidal 0.4 unidades / 5.5s",
    "onModeChange": "dolly out para enquadrar os karts dos amigos, 0.6s easeInOutCubic",
    "onInvite": "push in 0.35s no kart que acabou de entrar"
  },
  "safeZone3D": {
    "x": [
      470,
      1450
    ],
    "y": [
      300,
      860
    ],
    "rule": "nenhum elemento de UI opaco pode ocupar esta área",
    "derivedFrom": "Panel_Mode/Panel_Group terminam em x=448; Panel_Friends começa em x=1484. A zona franca é a faixa entre eles com 22px de respiro.",
    "kartRow": {
      "layout": "três grupos: [acompanhantes esquerda | KART DO JOGADOR | acompanhantes direita]",
      "rule": "O kart do jogador fica SEMPRE centrado em x=960, independente do modo. Os acompanhantes são distribuídos alternadamente à direita e à esquerda (1º direita, 2º esquerda, 3º direita), em dois grupos de largura fixa 298px.",
      "playerKartWidth": 340,
      "mateKartWidth": 140,
      "sideGroupWidth": 298,
      "gap": 18,
      "totalSquad": 934,
      "bounds": "x = [474, 1446] — dentro da zona franca com folga",
      "groundShadow": "elipse radial rgba(6,8,20,.72) sob cada kart, 0.8x da largura do kart",
      "verticalAnchor": {
        "rule": "OBRIGATÓRIO ancorar a fileira pela BASE (bottom), nunca por top/centro — só assim ela acompanha a plataforma do chão.",
        "anchorMin": [0.5, 0], "anchorMax": [0.5, 0], "pivot": [0.5, 0],
        "anchoredPosition": [0, 166],
        "childAlignment": "LowerCenter",
        "check": "a sombra de chão de cada kart deve cair na faixa frontal da plataforma: base da sombra ≈ y=860, entre o topo (725) e a base (976) da elipse. Se a base do kart ficar acima de y=760, ele lê como flutuando.",
        "platformReference": { "cx": 960, "width": 1080, "height": 250, "bottom": 104, "top": 725, "center": 850 }
      }
    }
  },
