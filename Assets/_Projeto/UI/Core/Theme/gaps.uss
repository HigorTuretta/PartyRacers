/* ============================================================
   gaps.uss — POLÍTICA DE ESPAÇAMENTO
   O UI Toolkit NÃO tem a propriedade "gap". Todo gap do HTML é
   traduzido para: margem em TODOS os filhos + margem NEGATIVA do
   mesmo valor no contêiner (cancela a sobra do último filho).
   Funciona com listas dinâmicas e não exige classe no primeiro filho.
   .gx-N = gap horizontal (row) · .gy-N = gap vertical (column)
   ============================================================ */

.gx-2 { margin-right: -2px; }
.gx-2 > * { margin-right: 2px; }
.gy-2 { margin-bottom: -2px; }
.gy-2 > * { margin-bottom: 2px; }

.gx-3 { margin-right: -3px; }
.gx-3 > * { margin-right: 3px; }
