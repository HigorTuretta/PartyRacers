/* Row_Standing.uss — HTML linhas 805-826 */
.stand__me-shadow { border-radius: 12px; }
.stand__me {
    padding: 10px 13px;
    border-width: 4px; border-color: var(--ink); border-radius: 12px;
    background-color: var(--amber);
}
.stand__me-pos {
    width: 30px; -unity-text-align: middle-center;
    -unity-font-definition: url("project://database/Assets/_Projeto/UI/Core/Fonts/TitanOne-Regular SDF.asset");
    font-size: 22px; color: var(--ink-15);
}
.stand__me-name {
    -unity-font-definition: url("project://database/Assets/_Projeto/UI/Core/Fonts/Archivo-Black SDF.asset");
    font-size: 16px; color: var(--ink-15); letter-spacing: 0.64px;
}
.stand__me-gap {
    -unity-font-definition: url("project://database/Assets/_Projeto/UI/Core/Fonts/SpaceMono-Bold SDF.asset");
    font-size: 14px; color: rgba(21, 22, 28, 0.70);
}
.stand__other { padding: 8px 13px; border-radius: 11px; background-color: var(--glass-72); }
.stand__other-pos {
    width: 30px; -unity-text-align: middle-center;
    -unity-font-definition: url("project://database/Assets/_Projeto/UI/Core/Fonts/Archivo-ExtraBold SDF.asset");
    font-size: 15px; color: var(--muted);
}
.stand__other-name {
    -unity-font-definition: url("project://database/Assets/_Projeto/UI/Core/Fonts/Archivo-Bold SDF.asset");
    font-size: 14px; color: var(--text); min-width: 0;
}
.stand__other-gap {
    -unity-font-definition: url("project://database/Assets/_Projeto/UI/Core/Fonts/SpaceMono-Regular SDF.asset");
    font-size: 13px; color: var(--dim);
}
